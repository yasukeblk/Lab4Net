[Unit]
Description=Lab4Net Operator OpenAI relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
EnvironmentFile=/etc/lab4net/assistant.env
ExecStart=/usr/bin/python3 /opt/lab4net-assistant/assistant_server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
